<?xml version="1.0" encoding="UTF-8"?>
<!-- Bloquea el acceso web directo a los datos guardados (IIS). Solo la API los lee. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="estado.php" />
          <add segment="estado.anterior.php" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="false" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
